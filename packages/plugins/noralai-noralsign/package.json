{
  "name": "@noralos-plugins/noralai-noralsign",
  "version": "0.1.0",
  "description": "NoralSign — document e-signing for NoralOS. Wraps a self-hosted DocuSeal instance behind a NoralOS-branded plugin surface. Exposes agent tools for the contract-routing flow (template lookup, submission creation, status polling, voiding, reminders, signed-document download), a webhook receiver for signer lifecycle events, and a Documents → NoralSign dashboard UI.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "noralosPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "prebuild": "pnpm --filter @noralos/plugin-sdk ensure-build-deps",
    "build": "tsc && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @noralos/plugin-sdk ensure-build-deps && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noralos/plugin-sdk": "workspace:*",
    "@noralos/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
